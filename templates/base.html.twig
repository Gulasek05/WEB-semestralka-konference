<!DOCTYPE html>
{# základ pro stránky #}
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# defaultní titulek stránky #}
    <title>{% block title %}GameDev Conf{% endblock %}</title>
    <link href="./assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="./assets/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/home"><i class="bi bi-controller"></i> GameDev conf</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/home">Domů</a></li>
                    {% if user %}
                    <li class="nav-item"><a class="nav-link" href="/logout">Odhlásit</a></li>
                    <li class="nav-item d-flex align-items-center">
                        <span class="navbar-text me-lg-3">
                            <i class="bi bi-person-circle"></i> {{ user.username }}
                        </span>
                    </li>
                    {% else %}
                    <li class="nav-item"><a class="nav-link" href="/login">Přihlásit</a></li>
                    <li class="nav-item"><a class="nav-link" href="/register">Registrace</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        {# blok co ostatní stránky přepíšou dle potřeby #}
        {% block content %}{% endblock %}
    </main>

    <footer class="container text-center text-muted py-3 border-top">
        Semestrální práce KIV/WEB
    </footer>

    <script src="./assets/js/bootstrap.min.js"></script>
</body>
</html>